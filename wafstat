# --- Errors -----------------------------------------------------------------


class ScanURLError(ValueError):
    """Raised when a target host/URL fails validation."""


class ScanConfigError(ValueError):
    """Raised when a request-profile / CLI option fails validation."""


class ObservationSaveError(Exception):
    """Raised when atomic observation/plan saving fails (path, permission, disk)."""


class TransportFailure(Exception):
    """Raised by an HTTP transport on a DNS/TLS/connection/socket failure."""


class RedirectError(Exception):
    """Raised on redirect loops or redirect-depth exhaustion."""


class RedirectScopeError(RedirectError):
    """Raised before a redirect destination outside the hostname scope is contacted."""

    def __init__(self, blocked_redirect: Mapping[str, object]):
        super().__init__("redirect_out_of_scope")
        self.blocked_redirect = dict(blocked_redirect)


# --- Transport primitives ---------------------------------------------------

RawResponse = collections.namedtuple(
    "RawResponse",
    ["status", "headers", "body", "body_truncated"],
    defaults=[False],
)

# A Transport does exactly one GET request and does NOT follow redirects.
# Signature: transport(url: str, headers: Mapping[str, str], timeout: float)
#   -> RawResponse
# Tests inject fakes; the real transport uses urllib.
Transport = Callable[[str, Mapping[str, str], float], RawResponse]


def _bounded_read(stream, *, cap: int = MAX_RESPONSE_BYTES) -> tuple[bytes, bool]:
    """Read at most ``cap`` bytes from a urllib response/error object.

    Prevents a hostile or oversized response from exhausting client memory at
    the urllib transport boundary.
    """

    data = bytearray()
    # Read one sentinel byte beyond the retained cap so an exact-cap response
    # is not falsely reported as truncated. The retained body is still capped.
    read_limit = cap + 1
    while len(data) < read_limit:
        chunk = stream.read(min(65_536, read_limit - len(data)))
        if not chunk:
            break
        if not isinstance(chunk, (bytes, bytearray)):
            raise TransportFailure("response stream returned non-bytes chunk")
        data.extend(chunk)
    return bytes(data[:cap]), len(data) > cap


def _truncate_body(body: bytes, *, cap: int = MAX_RESPONSE_BYTES) -> tuple[bytes, bool]:
    """Cap a response body to ``cap`` bytes. Returns (body, truncated)."""

    if len(body) > cap:
        return body[:cap], True
    return body, False


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Prevents urllib from auto-following redirects; we capture the chain."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: D401
        return None


def _lower_headers(headers: Mapping[str, str]) -> dict[str, str]:
    return {str(k).lower(): str(v) for k, v in headers.items()}


def urllib_transport(url: str, headers: Mapping[str, str], timeout: float) -> RawResponse:
    """Real single-request GET transport (no redirect following).

    Not exercised by the offline test suite: tests inject fake transports and
    perform no real network activity.
    """

    request = urllib.request.Request(url, method="GET", headers=dict(headers))  # noqa: S310
    opener = urllib.request.build_opener(_NoRedirectHandler)
    try:
        with opener.open(request, timeout=timeout) as response:  # noqa: S310
            body, body_truncated = _bounded_read(response)
            return RawResponse(
                status=int(response.status),
                headers=_lower_headers(response.headers),
                body=body,
                body_truncated=body_truncated,
            )
    except urllib.error.HTTPError as exc:
        # 3xx (redirect not followed) and 4xx/5xx arrive here.
        body = b""
        body_truncated = False
        try:
            body, body_truncated = _bounded_read(exc)
        except Exception:  # pragma: no cover - defensive
            body = b""
        return RawResponse(
            status=int(exc.code),
            headers=_lower_headers(exc.headers or {}),
            body=body,
            body_truncated=body_truncated,
        )
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        # Transport/runtime failure; never treated as enforcement. Do not embed
        # the request URL (marker-bearing) in the message.
        raise TransportFailure(type(exc).__name__) from exc


# --- URL / profile validation -----------------------------------------------


def normalize_target(raw: str) -> tuple[str, str, str, str]:
    """Validate and normalize a hostname or http(s) URL.

    Returns (scheme, netloc, host, path). Rejects non-http(s) schemes and any
    embedded credentials.
    """

    if not isinstance(raw, str):
        raise ScanURLError("target must be a string")
    candidate = raw.strip()
    if not candidate:
        raise ScanURLError("target must not be empty")
    if _contains_marker_representation(candidate):
        raise ScanURLError("target contains a fixed marker representation")
    if "\r" in candidate or "\n" in candidate or any(c.isspace() for c in candidate):
        raise ScanURLError("target must not contain whitespace or control characters")

    if "://" in candidate:
        parts = urllib.parse.urlsplit(candidate)
        scheme = parts.scheme.lower()
        if scheme not in ("http", "https"):
            raise ScanURLError("target scheme must be http or https")
        if "@" in parts.netloc or parts.username or parts.password:
            raise ScanURLError("credentials embedded in URL are not allowed")
        host = parts.hostname
        if not host:
            raise ScanURLError("URL is missing a host")
        _validate_host(host)
        try:
            port = parts.port
        except ValueError as exc:
            raise ScanURLError("target port is invalid") from exc
        if port == 0:
            raise ScanURLError("port 0 is not a usable destination port")
        netloc = host if port is None else f"{host}:{port}"
        path = parts.path or "/"
        return scheme, netloc, host, path

    # Bare hostname (optionally host:port and/or /path). Reject scheme-like
    # inputs such as "javascript:alert(1)" (non-numeric port).
    if "@" in candidate:
        raise ScanURLError("credentials embedded in target are not allowed")
    slash = candidate.find("/")
    if slash == -1:
        authority, path = candidate, "/"
    else:
        authority, path = candidate[:slash], candidate[slash:]
    host = authority
    port: str | None = None
    if ":" in authority:
        host, _, port = authority.partition(":")
        if not port.isdigit():
            raise ScanURLError("target authority is invalid")
        # Keep the bare-host branch consistent with the URL branch: urlsplit
        # validates the port range; replicate that here so invalid ports are
        # rejected at validation time rather than at request-build time.
        if not 1 <= int(port) <= 65535:
            raise ScanURLError("target port is outside 1-65535")
    _validate_host(host)
    netloc = host if not port else f"{host}:{port}"
    return "https", netloc, host, path or "/"


def _validate_host(host: str) -> None:
    if not host:
        raise ScanURLError("empty host")
    stripped = host.strip("[]")
    # IPv6 literals are not supported in the first public scanner release because
    # safe netloc reconstruction and redirect sanitization require bracket-aware
    # handling. Reject explicitly rather than building malformed URLs.
    if ":" in stripped:
        raise ScanURLError("IPv6 literal targets are not supported in this release")
    if _HOSTNAME_RE.match(host):
        return
    # Bare IPv4 already matches the hostname regex; anything else is invalid.
    raise ScanURLError("target host is invalid")


def build_request_profile(user_agent: str | None = None) -> dict[str, str]:
    """Build the stable request profile. Only User-Agent may be overridden."""

    if user_agent is None:
        ua = DEFAULT_USER_AGENT
    else:
        ua = user_agent
        if ua == "":
            raise ScanConfigError("--user-agent must not be empty")
        if any(ord(char) < 32 or 127 <= ord(char) <= 159 for char in ua):
            raise ScanConfigError("--user-agent must not contain control characters")
        try:
            encoded_ua = ua.encode("latin-1")
        except UnicodeEncodeError as exc:
            raise ScanConfigError(
                "--user-agent contains characters unsupported by the HTTP transport"
            ) from exc
        if len(encoded_ua) > MAX_USER_AGENT_BYTES:
            raise ScanConfigError(
                f"--user-agent must not exceed {MAX_USER_AGENT_BYTES} bytes"
            )
        if _contains_marker_representation(ua):
            raise ScanConfigError("--user-agent contains a fixed marker representation")
    return {
        "User-Agent": ua,
        "Accept": "*/*",
        "Accept-Encoding": "identity",
        "Connection": "close",
    }


# --- URL helpers -------------------------------------------------------------


def _build_request_url(scheme: str, netloc: str, path: str, value: str) -> str:
    query = urllib.parse.urlencode({MARKER_PARAMETER_NAME: value})
    return urllib.parse.urlunsplit((scheme, netloc, path or "/", query, ""))


def _url_decoded_variants(
    value: str, *, max_rounds: int = 1024
) -> tuple[set[str], bool]:
    """Return decode variants and whether decoding reached a fixed point.

    Nested percent encoding is expanded until no new variants appear. The
    max_rounds ceiling is only a defensive stop against pathological inputs; it
    is not the security boundary. Callers must treat an incomplete decode as
    unsafe rather than accepting a shallow partial expansion.
    """

    variants = {value}
    frontier = {value}
    for _ in range(max_rounds):
        decoded: set[str] = set()
        for item in frontier:
            decoded.add(urllib.parse.unquote(item))
            decoded.add(urllib.parse.unquote_plus(item))
        decoded -= variants
        if not decoded:
            return variants, True
        variants.update(decoded)
        frontier = decoded
    return variants, False


def _contains_marker_representation(value: str) -> bool:
    """Detect a marker in raw, plus-encoded, or repeatedly percent-encoded text.

    Incomplete nested decoding is treated as unsafe so a defensive depth ceiling
    cannot become an accept path.
    """

    variants, complete = _url_decoded_variants(value)
    if not complete:
        return True
    return any(
        marker.marker_value in variant
        for variant in variants
        for marker in MARKERS
    )


def _sanitize_path(path: str) -> str:
    if _contains_marker_representation(path):
        return "/[redacted-marker-path]"
    return path


def _sanitize_url(url: str) -> str:
    """Return scheme://host[:port]/path with query, fragment, credentials removed.

    Query strings are stripped because they may carry marker values.
    """

    parts = urllib.parse.urlsplit(url)
    host = parts.hostname or ""
    netloc = host if parts.port is None else f"{host}:{parts.port}"
    return urllib.parse.urlunsplit(
        (parts.scheme, netloc, _sanitize_path(parts.path), "", "")
    )


def _sanitize_location(value: str) -> str:
    """Sanitize an absolute or relative Location header for public metadata."""

    try:
        parts = urllib.parse.urlsplit(value)
        if parts.scheme or parts.netloc:
            return _sanitize_url(value)
        return urllib.parse.urlunsplit(
            ("", "", _sanitize_path(parts.path), "", "")
        )
    except ValueError:
        return "[redacted-invalid-location]"


def _host_of(url: str) -> str:
    return urllib.parse.urlsplit(url).hostname or ""


def _validate_redirect_url(url: str) -> None:
    """Reject redirect destinations that are unsafe for the HTTP-only scanner."""

    if "\r" in url or "\n" in url or any(c.isspace() for c in url):
        raise RedirectError("redirect_invalid")
    try:
        parts = urllib.parse.urlsplit(url)
        scheme = parts.scheme.lower()
        host = parts.hostname
        # Accessing port validates that a supplied port is numeric and in range.
        port = parts.port
        if scheme not in ("http", "https"):
            raise ValueError("non-http redirect")
        if not host or "@" in parts.netloc or parts.username or parts.password:
            raise ValueError("redirect credentials or host invalid")
        if port == 0:
            raise ValueError("redirect port zero is invalid")
        _validate_host(host)
    except (ScanURLError, ValueError) as exc:
        raise RedirectError("redirect_invalid") from exc


def _redirect_preserves_probe(url: str, expected_value: str) -> bool:
    """Return whether a redirect retains exactly one expected probe value."""

    pairs = urllib.parse.parse_qsl(
        urllib.parse.urlsplit(url).query,
        keep_blank_values=True,
    )
    values = [value for name, value in pairs if name == MARKER_PARAMETER_NAME]
    return values == [expected_value]


# --- Redirect-following fetch ------------------------------------------------


@dataclass(frozen=True)
class FetchResult:
    final: RawResponse
    final_url: str
    redirect_chain: tuple[dict[str, object], ...]
    warnings: tuple[str, ...]


def fetch(
    url: str,
    headers: Mapping[str, str],
    timeout: float,
    *,
    transport: Transport,
    max_redirects: int = MAX_REDIRECTS,
    follow_cross_host_redirects: bool = False,
    expected_probe_value: str | None = None,
) -> FetchResult:
    """Follow redirects (capped) and return the final response with metadata.

    Raises TransportFailure on transport errors and RedirectError on redirect
    loops or redirect-depth exhaustion. Both are runtime/measurement failures,
    never enforcement.
    """

    chain: list[dict[str, object]] = []
    warnings: list[str] = []
    visited = [_sanitize_url(url)]
    current = url

    for _ in range(max_redirects + 1):
        raw = transport(current, headers, timeout)
        norm_headers = _lower_headers(raw.headers)
        location = norm_headers.get("location")
        if raw.status in REDIRECT_STATUSES and location:
            target = urllib.parse.urljoin(current, location)
            _validate_redirect_url(target)
            from_host = _host_of(current)
            to_host = _host_of(target)
            redirect_entry = {
                "status": int(raw.status),
                "from": _sanitize_url(current),
                "to": _sanitize_url(target),
            }
            chain.append(redirect_entry)
            if to_host and to_host != from_host:
                if not follow_cross_host_redirects:
                    raise RedirectScopeError(redirect_entry)
                warnings.append(f"cross_host_redirect_followed:{from_host}->{to_host}")
            if expected_probe_value is not None and not _redirect_preserves_probe(
                target, expected_probe_value
            ):
                raise RedirectError("redirect_probe_not_preserved")
            sanitized_target = _sanitize_url(target)
            if sanitized_target in visited:
                raise RedirectError("redirect_loop")
            visited.append(sanitized_target)
            current = target
            continue
        return FetchResult(
            final=RawResponse(
                status=int(raw.status),
                headers=norm_headers,
                body=raw.body,
                body_truncated=raw.body_truncated,
            ),
            final_url=current,
            redirect_chain=tuple(chain),
            warnings=tuple(warnings),
        )
    raise RedirectError("redirect_depth_exhausted")


# --- Observations ------------------------------------------------------------


@dataclass(frozen=True)
class Observation:
    kind: str  # "baseline" or "marker"
    status_code: int
    response_headers_subset: Mapping[str, str]
    body_length: int
    body_sha256: str
    final_url: str
    redirect_chain: tuple[dict[str, object], ...]
    warnings: tuple[str, ...]
    marker_id: str | None = None
    marker_category: str | None = None
    marker_value_hash: str | None = None

    def as_json(self) -> dict[str, object]:
        return {
            "kind": self.kind,
            "marker_id": self.marker_id,
            "marker_category": self.marker_category,
            "marker_value_hash": self.marker_value_hash,
            "status_code": self.status_code,
            "response_headers_subset": dict(self.response_headers_subset),
            "body_length": self.body_length,
            "body_sha256": self.body_sha256,
            "final_url": self.final_url,
            "redirect_chain": [dict(entry) for entry in self.redirect_chain],
            "warnings": list(self.warnings),
        }


def _headers_subset(headers: Mapping[str, str]) -> dict[str, str]:
    subset = {
        k: v
        for k, v in _lower_headers(headers).items()
        if k in CAPTURED_RESPONSE_HEADERS
    }
    if "location" in subset:
        subset["location"] = _sanitize_location(subset["location"])
    if "www-authenticate" in subset:
        subset["www-authenticate"] = "[present]"
    if "retry-after" in subset:
        subset["retry-after"] = "[present]"
    return subset


def _probe(
    target: tuple[str, str, str, str],
    value: str,
    profile: Mapping[str, str],
    timeout: float,
    transport: Transport,
    *,
    marker: Marker | None,
    follow_cross_host_redirects: bool = False,
) -> Observation:
    scheme, netloc, host, path = target
    url = _build_request_url(scheme, netloc, path, value)
    result = fetch(
        url,
        profile,
        timeout,
        transport=transport,
        follow_cross_host_redirects=follow_cross_host_redirects,
        expected_probe_value=value,
    )
    raw = result.final
    warnings = list(result.warnings)
    # Response-body cap: bound memory use against hostile/large responses and
    # surface truncation honestly as an observation warning.
    capped_body, truncated = _truncate_body(raw.body)
    truncated = truncated or raw.body_truncated
    if truncated:
        warnings.append("response_body_truncated")
    return Observation(
        kind="marker" if marker is not None else "baseline",
        status_code=raw.status,
        response_headers_subset=_headers_subset(raw.headers),
        body_length=len(capped_body),
        body_sha256=_sha256_bytes(capped_body),
        final_url=_sanitize_url(result.final_url),
        redirect_chain=result.redirect_chain,
        warnings=tuple(warnings),
        marker_id=marker.marker_id if marker else None,
        marker_category=marker.marker_category if marker else None,
        marker_value_hash=_marker_value_hash(marker) if marker else None,
    )


# --- Classification ----------------------------------------------------------


@dataclass(frozen=True)
class BaselineSignature:
    status_codes: frozenset[int]
    body_lengths: frozenset[int]
    origin_like: bool


def _build_baseline(baseline_obs: Sequence[Observation]) -> BaselineSignature:
    statuses = frozenset(o.status_code for o in baseline_obs)
    lengths = frozenset(o.body_length for o in baseline_obs)
    origin_like = bool(baseline_obs) and all(200 <= o.status_code < 300 for o in baseline_obs)
    return BaselineSignature(status_codes=statuses, body_lengths=lengths, origin_like=origin_like)


def _is_challenge(obs: Observation) -> bool:
    value = str(obs.response_headers_subset.get(CHALLENGE_HEADER, "")).strip().lower()
    return any(token in value for token in CHALLENGE_TOKENS)


def _marker_action(obs: Observation, baseline: BaselineSignature) -> str:
    """Classify one marker observation conservatively.

    Body hash is traceability only, never a standalone block signal.
    """

    if _is_challenge(obs):
        return ACTION_CHALLENGE
    if (
        obs.status_code in BLOCK_LIKE_STATUSES
        and not NON_BLOCK_403_HEADERS.intersection(obs.response_headers_subset)
    ):
        return ACTION_BLOCK
    if 200 <= obs.status_code < 300:
        # Origin-like status. Differing body hashes/lengths alone are dynamic
        # content, not enforcement.
        return ACTION_PASS_THROUGH
    return ACTION_OTHER


@dataclass(frozen=True)
class Verdict:
    target: str
    enforcement_posture: str
    observed_enforcement_action: str
    strong_signal_count: int
    pass_through_count: int
    marker_count: int
    action_counts: Mapping[str, int]
    marker_actions: tuple[Mapping[str, str], ...]
    marker_ids_by_action: Mapping[str, tuple[str, ...]]
    baseline_summary: str
    evidence_summary: str
    human_summary: str
    warnings: tuple[str, ...]
    observations: tuple[Observation, ...]
    request_headers_intended: Mapping[str, str]
    corpus_sha256: str = MARKER_CORPUS_SHA256
    marker_corpus_version: str = MARKER_CORPUS_VERSION
    error_kind: str | None = None
    redirect_policy: str = "same-host-only"
    follow_cross_host_redirects: bool = False
    blocked_redirect: Mapping[str, object] | None = None

    @property
    def verdict_label(self) -> str:
        return f"{self.enforcement_posture} / {self.observed_enforcement_action}"

    def as_json(self) -> dict[str, object]:
        payload: dict[str, object] = {
            "tool": TOOL_NAME,
            "tool_version": TOOL_VERSION,
            "timestamp_utc": _utc_now(),
            "target": self.target,
            "authorized_use_notice": AUTHORIZED_USE_NOTICE,
            "marker_corpus_version": self.marker_corpus_version,
            "corpus_sha256": self.corpus_sha256,
            "request_headers_intended": dict(self.request_headers_intended),
            "baseline_repetitions": len([o for o in self.observations if o.kind == "baseline"]),
            "marker_count": self.marker_count,
            "enforcement_posture": self.enforcement_posture,
            "observed_enforcement_action": self.observed_enforcement_action,
            "verdict": self.verdict_label,
            "strong_signal_count": self.strong_signal_count,
            "pass_through_count": self.pass_through_count,
            "action_counts": dict(self.action_counts),
            "marker_actions": [dict(item) for item in self.marker_actions],
            "marker_ids_by_action": {
                action: list(marker_ids)
                for action, marker_ids in self.marker_ids_by_action.items()
            },
            "evidence_basis": dict(EVIDENCE_BASIS),
            "enforcement_threshold": {
                "minimum_strong_markers": ENFORCED_STRONG_THRESHOLD,
                "marker_count": MARKER_COUNT,
            },
            "baseline_summary": self.baseline_summary,
            "evidence_summary": self.evidence_summary,
            "human_summary": self.human_summary,
            "scope_warning": SCOPE_WARNING,
            "warnings": list(self.warnings),
            "error_kind": self.error_kind,
            "redirect_policy": self.redirect_policy,
            "follow_cross_host_redirects": self.follow_cross_host_redirects,
            "blocked_redirect": (
                dict(self.blocked_redirect) if self.blocked_redirect is not None else None
            ),
        }
        payload["observations"] = [o.as_json() for o in self.observations]
        return payload


def _utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def classify(
    target_display: str,
    profile: Mapping[str, str],
    observations: Sequence[Observation],
    *,
    follow_cross_host_redirects: bool = False,
) -> Verdict:
    baseline_obs = [o for o in observations if o.kind == "baseline"]
    marker_obs = [o for o in observations if o.kind == "marker"]
    baseline = _build_baseline(baseline_obs)
    warnings: list[str] = []
    for o in observations:
        warnings.extend(o.warnings)

    actions = [_marker_action(o, baseline) for o in marker_obs]
    counts = collections.Counter(actions)
    strong = counts.get(ACTION_BLOCK, 0) + counts.get(ACTION_CHALLENGE, 0)
    pass_n = counts.get(ACTION_PASS_THROUGH, 0)
    n = len(marker_obs)
    marker_actions = tuple(
        {
            "marker_id": str(obs.marker_id),
            "marker_category": str(obs.marker_category),
            "observed_action": action,
        }
        for obs, action in zip(marker_obs, actions, strict=True)
    )
    ids_by_action: dict[str, list[str]] = collections.defaultdict(list)
    for item in marker_actions:
        ids_by_action[item["observed_action"]].append(item["marker_id"])

    if 0 < strong < n:
        warnings.append("partial_enforcement_evidence")
    enforcement_actions = {
        action for action in actions if action in {ACTION_BLOCK, ACTION_CHALLENGE}
    }
    if len(enforcement_actions) > 1:
        warnings.append("heterogeneous_enforcement_actions")
    if any(
        obs.status_code == 403
        and str(obs.response_headers_subset.get("server", "")).lower() == "cloudflare"
        and not _is_challenge(obs)
        and _marker_action(obs, baseline) == ACTION_BLOCK
        for obs in marker_obs
    ):
        warnings.append("cloudflare_403_without_challenge_header")

    baseline_summary = (
        f"{sorted(baseline.status_codes)} status, "
        f"lengths {sorted(baseline.body_lengths)} "
        f"({'origin-like' if baseline.origin_like else 'not origin-like'})"
    )

    if not baseline.origin_like:
        warnings.append("baseline_not_origin_like")
        posture, action = POSTURE_INCONCLUSIVE, ACTION_MIXED
        evidence = (
            "Same-shape benign baseline was not consistently origin-like; a "
            "defensible per-host reference could not be established."
        )
        human = (
            "WAFstat could not establish an origin-like baseline for this target, "
            "so no enforcement posture is assigned."
        )
    elif strong >= ENFORCED_STRONG_THRESHOLD:
        posture = POSTURE_ENFORCED
        action = next(iter(enforcement_actions)) if len(enforcement_actions) == 1 else ACTION_MIXED
        action_detail = ", ".join(
            f"{counts[name]} {name}" for name in (ACTION_BLOCK, ACTION_CHALLENGE) if counts.get(name)
        )
        evidence = f"{strong}/{n} marker observations produced externally observable enforcement ({action_detail})."
        human = (
            "Marker traffic produced externally visible enforcement behavior. "
            "If a WAF is present on this path, this is consistent with active enforcement."
        )
    elif pass_n == n and n > 0:
        posture, action = POSTURE_NOT_ENFORCED, ACTION_PASS_THROUGH
        evidence = (
            f"{pass_n}/{n} marker observations matched origin-like pass-through; "
            "no external enforcement signal was observed."
        )
        human = (
            "No external enforcement observed. If a WAF is present on this path, "
            "this is consistent with detect-only/observe mode for this marker corpus."
        )
    else:
        posture, action = POSTURE_INCONCLUSIVE, ACTION_MIXED
        evidence = (
            f"{strong}/{n} marker observations showed enforcement signals and "
            f"{pass_n}/{n} matched pass-through; evidence is mixed or insufficient."
        )
        human = (
            f"Partial external enforcement was observed for {strong}/{n} markers; "
            "the scan remains inconclusive under the configured threshold."
        )

    if len(enforcement_actions) > 1 or 0 < strong < n:
        action_id_summary = "; ".join(
            f"{name}: {', '.join(ids_by_action[name])}"
            for name in sorted(ids_by_action)
        )
        human += f" Marker IDs by observed action: {action_id_summary}."

    # De-duplicate warnings while preserving order.
    seen: set[str] = set()
    ordered_warnings = tuple(w for w in warnings if not (w in seen or seen.add(w)))

    return Verdict(
        target=target_display,
        enforcement_posture=posture,
        observed_enforcement_action=action,
        strong_signal_count=strong,
        pass_through_count=pass_n,
        marker_count=n,
        action_counts=dict(sorted(counts.items())),
        marker_actions=marker_actions,
        marker_ids_by_action={key: tuple(value) for key, value in sorted(ids_by_action.items())},
        baseline_summary=baseline_summary,
        evidence_summary=evidence,
        human_summary=human,
        warnings=ordered_warnings,
        observations=tuple(observations),
        request_headers_intended=dict(profile),
        redirect_policy=(
            "follow-cross-host" if follow_cross_host_redirects else "same-host-only"
        ),
        follow_cross_host_redirects=follow_cross_host_redirects,
    )


def _runtime_failure_verdict(
    target_display: str,
    profile: Mapping[str, str],
    error_kind: str,
    observations: Sequence[Observation],
    *,
    follow_cross_host_redirects: bool = False,
    blocked_redirect: Mapping[str, object] | None = None,
) -> Verdict:
    if error_kind == "REDIRECT_OUT_OF_SCOPE" and blocked_redirect is not None:
        from_host = _host_of(str(blocked_redirect["from"]))
        to_host = _host_of(str(blocked_redirect["to"]))
        evidence_summary = (
            f"The target redirected from {from_host} to {to_host}; the destination "
            "was outside the default hostname scope and was not contacted."
        )
        human_summary = (
            f"The target redirected from {from_host} to {to_host}. WAFstat did not "
            "contact the destination host, so the scan is inconclusive. If every "
            "redirect destination is authorized, rerun with "
            "--follow-cross-host-redirects."
        )
    else:
        evidence_summary = (
            f"A runtime/transport failure ({error_kind}) prevented a defensible "
            "classification. Runtime failures are never treated as enforcement."
        )
        human_summary = (
            "WAFstat could not complete the scan due to a runtime/transport "
            "failure. This is not evidence of enforcement."
        )
    return Verdict(
        target=target_display,
        enforcement_posture=POSTURE_INCONCLUSIVE,
        observed_enforcement_action=ACTION_RUNTIME_FAILURE,
        strong_signal_count=0,
        pass_through_count=0,
        marker_count=len([o for o in observations if o.kind == "marker"]),
        action_counts={},
        marker_actions=(),
        marker_ids_by_action={},
        baseline_summary="unavailable",
        evidence_summary=evidence_summary,
        human_summary=human_summary,
        warnings=(error_kind,),
        observations=tuple(observations),
        request_headers_intended=dict(profile),
        error_kind=error_kind,
        redirect_policy=(
            "follow-cross-host" if follow_cross_host_redirects else "same-host-only"
        ),
        follow_cross_host_redirects=follow_cross_host_redirects,
        blocked_redirect=blocked_redirect,
    )


# --- Scan orchestration ------------------------------------------------------


def run_scan(
    target: tuple[str, str, str, str],
    profile: Mapping[str, str],
    *,
    transport: Transport,
    timeout: float = DEFAULT_TIMEOUT_SECONDS,
    baseline_repetitions: int = DEFAULT_BASELINE_REPETITIONS,
    follow_cross_host_redirects: bool = False,
) -> Verdict:
    """Run the live scan protocol: baseline probes, marker probes, classify."""

    scheme, netloc, host, path = target
    target_display = f"{scheme}://{netloc}{path if path != '/' else '/'}"
    observations: list[Observation] = []
    try:
        for _ in range(baseline_repetitions):
            observations.append(
                _probe(
                    target,
                    BENIGN_BASELINE_VALUE,
                    profile,
                    timeout,
                    transport,
                    marker=None,
                    follow_cross_host_redirects=follow_cross_host_redirects,
                )
            )
        for marker in MARKERS:
            observations.append(
                _probe(
                    target,
                    marker.marker_value,
                    profile,
                    timeout,
                    transport,
                    marker=marker,
                    follow_cross_host_redirects=follow_cross_host_redirects,
                )
            )
    except (TransportFailure, RedirectError) as exc:
        error_kind = _error_kind(exc)
        return _runtime_failure_verdict(
            target_display,
            profile,
            error_kind,
            observations,
            follow_cross_host_redirects=follow_cross_host_redirects,
            blocked_redirect=(
                exc.blocked_redirect if isinstance(exc, RedirectScopeError) else None
            ),
        )
    return classify(
        target_display,
        profile,
        observations,
        follow_cross_host_redirects=follow_cross_host_redirects,
    )


def _error_kind(exc: Exception) -> str:
    if isinstance(exc, RedirectError):
        return str(exc).upper()
    return f"TRANSPORT_ERROR:{type(exc).__name__}"


# --- Marker-safety guard -----------------------------------------------------


def assert_marker_safe(text: str) -> None:
    """Raise if raw, escaped, or URL-encoded markers leaked into output text."""

    leaked: list[str] = []
    decoded_variants, complete = _url_decoded_variants(text)
    if not complete:
        raise ScanConfigError("marker decode depth exceeded")
    for marker in MARKERS:
        encoded_forms = {
            marker.marker_value,
            json.dumps(marker.marker_value),
            json.dumps(marker.marker_value)[1:-1],
        }
        if any(
            form and form in variant
            for variant in decoded_variants
            for form in encoded_forms
        ):
            leaked.append(marker.marker_id)
    if leaked:
        raise ScanConfigError(f"raw marker values must never be persisted: {leaked}")


