# --- Rendering ---------------------------------------------------------------


def render_dry_run(plan: Mapping[str, object]) -> str:
    lines = [
        f"{TOOL_NAME} {TOOL_VERSION}",
        "mode: dry-run",
        "network_activity: none",
        f"target: {plan['target']}",
        f"authorized_use_notice: {plan['authorized_use_notice']}",
        f"marker_corpus_version: {plan['marker_corpus_version']}",
        f"corpus_sha256: {plan['corpus_sha256']}",
        f"marker_count: {plan['marker_count']}",
        "marker_ids: " + ",".join(plan["marker_ids"]),  # type: ignore[arg-type]
        "marker_categories: " + ",".join(plan["marker_categories"]),  # type: ignore[arg-type]
        f"marker_parameter_name: {plan['marker_parameter_name']}",
        f"baseline_repetitions: {plan['baseline_repetitions']}",
        f"planned_request_count: {plan['planned_request_count']}",
        f"maximum_transport_requests: {plan['maximum_transport_requests']}",
        f"request_profile: {plan['request_profile']}",
        "request_headers_intended:",
    ]
    for key, value in plan["request_headers_intended"].items():  # type: ignore[union-attr]
        lines.append(f"  {key}: {value}")
    lines.append(f"timeout_seconds: {plan['timeout_seconds']:g}")
    lines.append(f"max_redirects: {plan['max_redirects']}")
    lines.append(f"redirect_policy: {plan['redirect_policy']}")
    threshold = plan["enforcement_threshold"]
    lines.append(
        "enforcement_threshold: "
        f"{threshold['minimum_strong_markers']}/{threshold['marker_count']}"  # type: ignore[index]
    )
    evidence = plan["evidence_basis"]
    lines.append(f"uses_private_configuration: {str(evidence['uses_private_configuration']).lower()}")  # type: ignore[index]
    lines.append(f"uses_provider_api: {str(evidence['uses_provider_api']).lower()}")  # type: ignore[index]
    lines.append(f"uses_origin_logs: {str(evidence['uses_origin_logs']).lower()}")  # type: ignore[index]
    lines.append(f"scope_warning: {plan['scope_warning']}")
    return "\n".join(lines)


def render_verdict(verdict: Verdict) -> str:
    lines = [
        f"{TOOL_NAME} {TOOL_VERSION}",
        f"  Target:   {verdict.target}",
        f"  Baseline: {verdict.baseline_summary}",
    ]
    if verdict.error_kind is None:
        lines.append(
            f"  Markers:  {verdict.strong_signal_count}/{verdict.marker_count} strong enforcement, "
            f"{verdict.pass_through_count}/{verdict.marker_count} pass-through"
        )
    lines.append(f"  Verdict:  {verdict.verdict_label}")
    if verdict.error_kind is not None:
        lines.append(f"  Reason:   {verdict.error_kind}")
    lines.append(f"            {verdict.human_summary}")
    if verdict.warnings:
        lines.append("  Warnings: " + ", ".join(verdict.warnings))
    lines.append(f"  Note:     {SCOPE_WARNING}")
    return "\n".join(lines)


# --- CLI ---------------------------------------------------------------------


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="wafstat",
        description=(
            "WAFstat live enforcement-verification scanner. Verifies whether a "
            "fixed marker corpus produces externally observable WAF enforcement "
            "on an authorized target. Not a fingerprinting or bypass tool. "
            + AUTHORIZED_USE_NOTICE
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)
    scan = sub.add_parser(
        "scan",
        help="Scan a single authorized host.",
        description=(
            "Send the bounded WAFstat marker protocol to one authorized host. "
            + AUTHORIZED_USE_NOTICE
        ),
    )
    scan.add_argument("host", help="Hostname or http(s) URL of the authorized target.")
    scan.add_argument("--dry-run", action="store_true", help="Show the plan and send no traffic.")
    scan.add_argument(
        "--follow-cross-host-redirects",
        action="store_true",
        help=(
            "Follow redirects to different hostnames. Use only when every "
            "redirect destination is authorized; same-host redirects are followed "
            "by default."
        ),
    )
    scan.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    scan.add_argument("--save-observations", metavar="PATH", help="Write bodyless, marker-safe observations/verdict to PATH.")
    scan.add_argument(
        "--user-agent",
        metavar="VALUE",
        help=(
            "Override the default User-Agent (non-empty, transport-safe, "
            f"maximum {MAX_USER_AGENT_BYTES} bytes)."
        ),
    )
    return parser


def _emit(payload: object, *, as_json: bool, text: str) -> None:
    if as_json:
        rendered = json.dumps(payload, indent=2, sort_keys=True)
        assert_marker_safe(rendered)
        print(rendered)
    else:
        assert_marker_safe(text)
        print(text)


def _save(path: str, payload: Mapping[str, object]) -> None:
    """Write payload to ``path`` atomically: temp file + os.replace.

    Leaving no partial file on interrupt/failure and ensuring the destination
    only ever contains a complete JSON document.
    """

    text = json.dumps(payload, indent=2, sort_keys=True)
    assert_marker_safe(text)
    dest = os.path.abspath(path)
    dest_dir = os.path.dirname(dest) or "."
    try:
        fd, tmp_name = tempfile.mkstemp(prefix=".wafstat-", suffix=".tmp", dir=dest_dir)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text + "\n")
        os.replace(tmp_name, dest)
    except OSError as exc:
        try:
            os.unlink(tmp_name)
        except (OSError, UnboundLocalError):
            pass
        raise ObservationSaveError("could not write observations") from exc


def _print_cli_error(exc: Exception) -> None:
    """Print an application-controlled error without marker-bearing content."""

    message = str(exc)
    try:
        assert_marker_safe(message)
    except ScanConfigError:
        message = "input was rejected by marker-safety validation"
    print(f"wafstat error: {message}", file=sys.stderr)


def main(argv: list[str] | None = None, *, transport: Transport | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)

    if args.command != "scan":  # pragma: no cover - argparse enforces this
        parser.error("unknown command")

    try:
        target = normalize_target(args.host)
        profile = build_request_profile(args.user_agent)
    except (ScanURLError, ScanConfigError) as exc:
        _print_cli_error(exc)
        return EXIT_SAFETY

    if args.dry_run:
        plan = build_dry_run_plan(
            target,
            profile,
            follow_cross_host_redirects=args.follow_cross_host_redirects,
        )
        _emit(plan, as_json=args.json, text=render_dry_run(plan))
        if args.save_observations:
            try:
                _save(args.save_observations, plan)
            except ObservationSaveError as exc:
                _print_cli_error(exc)
                return EXIT_SAFETY
        return EXIT_OK

    print(AUTHORIZED_USE_NOTICE, file=sys.stderr)
    if args.follow_cross_host_redirects:
        print(CROSS_HOST_AUTH_NOTICE, file=sys.stderr)
    active_transport = transport if transport is not None else urllib_transport
    verdict = run_scan(
        target,
        profile,
        transport=active_transport,
        follow_cross_host_redirects=args.follow_cross_host_redirects,
    )
    _emit(verdict.as_json(), as_json=args.json, text=render_verdict(verdict))
    if args.save_observations:
        try:
            _save(args.save_observations, verdict.as_json())
        except ObservationSaveError as exc:
            _print_cli_error(exc)
            return EXIT_SAFETY
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())
