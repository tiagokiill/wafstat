def _sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def _sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def _canonical_corpus_json() -> str:
    """Deterministic JSON matching src/marker_corpus.canonical_corpus_json()."""

    return json.dumps(
        [
            {
                "marker_id": marker.marker_id,
                "marker_category": marker.marker_category,
                "marker_value": marker.marker_value,
            }
            for marker in MARKERS
        ],
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    )


MARKER_CORPUS_SHA256 = _sha256_text(_canonical_corpus_json())


def _marker_value_hash(marker: Marker) -> str:
